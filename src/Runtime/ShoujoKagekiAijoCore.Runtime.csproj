<Project Sdk="Godot.NET.Sdk/4.5.1">
 <PropertyGroup>
  <GodotProjectDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../'))</GodotProjectDir>
  <GodotProjectDirBase64>$([MSBuild]::ConvertToBase64('$(GodotProjectDir)'))</GodotProjectDirBase64>
  <EnableDynamicLoading>true</EnableDynamicLoading>
  <AssemblyName Condition="'$(Sts2Api)' == 'stable'">ShoujoKagekiAijoCore.Runtime.Stable</AssemblyName>
  <AssemblyName Condition="'$(Sts2Api)' == 'beta'">ShoujoKagekiAijoCore.Runtime.Beta</AssemblyName>
 </PropertyGroup>
 <Import Project="../../build/GameReferences.props" />
 <ItemGroup>
  <ProjectReference Include="../Api.V1/ShoujoKagekiAijoCore.Api.V1.csproj" />
  <Reference Include="BaseLib"><HintPath>$(BaseLibPath)</HintPath><Private>false</Private></Reference>
  <Compile Include="../Modules/**/*.cs" Exclude="../Modules/**/obj/**;../Modules/**/bin/**" />
  <Compile Include="../Patches/**/*.cs" />
  <Compile Include="../Compatibility/**/*.cs" />
  <EmbeddedResource Include="$(TelemetryEndpointPath)" LogicalName="CoreTelemetryEndpoint.json" Condition="'$(TelemetryEndpointPath)' != '' and Exists('$(TelemetryEndpointPath)')" />
 </ItemGroup>
</Project>
